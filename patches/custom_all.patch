+
+#include "client/default_credentials.h"
+
+#include <QByteArray>
+#include <QCoreApplication>
+#include <QDir>
+#include <QSettings>
+
+#include "base/crypto/os_crypt.h"
+#include "base/logging.h"
+
+namespace {
+
+const QString kFileName = QStringLiteral("aspia_default_login.ini");
+const QString kEnabledParam = QStringLiteral("enabled");
+const QString kUserNameParam = QStringLiteral("user_name");
+const QString kPasswordParam = QStringLiteral("password");
+
+//--------------------------------------------------------------------------------------------------
+QString settingsPath()
+{
+    return QDir(QCoreApplication::applicationDirPath()).filePath(kFileName);
+}
+
+} // namespace
+
+//--------------------------------------------------------------------------------------------------
+std::optional<DefaultCredentials> loadDefaultCredentials()
+{
+    QSettings settings(settingsPath(), QSettings::IniFormat);
+
+    if (!settings.value(kEnabledParam, true).toBool())
+        return std::nullopt;
+
+    const QString username = settings.value(kUserNameParam).toString();
+    const QByteArray encrypted =
+        QByteArray::fromBase64(settings.value(kPasswordParam).toByteArray());
+
+    if (username.isEmpty() || encrypted.isEmpty())
+        return std::nullopt;
+
+    QByteArray plain;
+    if (!OSCrypt::decryptBytes(encrypted, &plain) || plain.isEmpty())
+    {
+        // DPAPI binds the value to the current Windows account. A copied green folder simply
+        // behaves as if no defaults were stored: the user is asked once and new ones are saved.
+        LOG(WARNING) << "Unable to decrypt default credentials (another Windows account?)";
+        return std::nullopt;
+    }
+
+    DefaultCredentials result;
+    result.username = username;
+    result.password = SecureString(QString::fromUtf8(plain));
+    plain.fill('\0');
+
+    if (result.password.isEmpty())
+        return std::nullopt;
+
+    return result;
+}
+
+//--------------------------------------------------------------------------------------------------
+bool saveDefaultCredentials(const QString& username, const SecureString& password)
+{
+    if (username.isEmpty() || password.isEmpty())
+        return false;
+
+    QByteArray encrypted;
+    const QByteArray plain = password.toString().toUtf8();
+
+    if (!OSCrypt::encryptBytes(plain, &encrypted) || encrypted.isEmpty())
+    {
+        LOG(ERROR) << "Unable to encrypt default credentials";
+        return false;
+    }
+
+    QSettings settings(settingsPath(), QSettings::IniFormat);
+    settings.setValue(kEnabledParam, true);
+    settings.setValue(kUserNameParam, username);
+    settings.setValue(kPasswordParam, encrypted.toBase64());
+    settings.sync();
+
+    if (settings.status() != QSettings::NoError)
+    {
+        LOG(ERROR) << "Unable to write" << settingsPath();
+        return false;
+    }
+
+    LOG(INFO) << "Default credentials saved to" << settingsPath();
+    return true;
+}
+
+//--------------------------------------------------------------------------------------------------
+void clearDefaultCredentials()
+{
+    QSettings settings(settingsPath(), QSettings::IniFormat);
+    settings.remove(kUserNameParam);
+    settings.remove(kPasswordParam);
+    settings.sync();
+}
