+//--------------------------------------------------------------------------------------------------
+void MainWindow::createQuickPanel()
+{
+    quick_panel_ = new QFrame(this);
+    quick_panel_->setFrameShape(QFrame::StyledPanel);
+    quick_panel_->setAutoFillBackground(true);
+    quick_panel_->setVisible(false);
+
+    quick_panel_layout_ = new QBoxLayout(QBoxLayout::LeftToRight, quick_panel_);
+    quick_panel_layout_->setContentsMargins(6, 4, 6, 4);
+    quick_panel_layout_->setSpacing(2);
+}
+
+//--------------------------------------------------------------------------------------------------
+void MainWindow::rebuildQuickPanel(Tab* tab)
+{
+    if (!quick_panel_layout_)
+        return;
+
+    while (QLayoutItem* item = quick_panel_layout_->takeAt(0))
+    {
+        delete item->widget();
+        delete item;
+    }
+
+    int action_count = 0;
+
+    auto add_action = [this, &action_count](QAction* action)
+    {
+        if (!action || !action->isVisible() || action_count >= kQuickPanelMaxActions)
+            return;
+        if (action->property(Tab::kMenuOnlyProperty).toBool())
+            return;
+
+        QToolButton* button = new QToolButton(quick_panel_);
+        button->setDefaultAction(action);
+        button->setAutoRaise(true);
+        button->setIconSize(QSize(20, 20));
+        button->setToolButtonStyle(
+            action->icon().isNull() ? Qt::ToolButtonTextOnly : Qt::ToolButtonIconOnly);
+        quick_panel_layout_->addWidget(button);
+
+        ++action_count;
+    };
+
+    auto add_separator = [this]()
+    {
+        if (quick_panel_layout_->count() == 0)
+            return;
+
+        QFrame* line = new QFrame(quick_panel_);
+        line->setFrameShape(QFrame::VLine);
+        line->setFrameShadow(QFrame::Sunken);
+        quick_panel_layout_->addWidget(line);
+    };
+
+    // The menu bar is hidden, so the global actions live only here (and in the tab context
+    // menus, which stay available).
+    add_action(ui->action_quick_connect);
+    add_action(ui->action_credentials);
+    add_action(ui->action_settings);
+
+    if (tab && tab->tabType() == Tab::Type::SESSION)
+    {
+        for (const Tab::ActionGroupEntry& group : tab->actionGroups())
+        {
+            bool group_used = false;
+
+            for (QAction* action : group.second)
+            {
+                const int before = action_count;
+
+                // Icon-only entries keep the panel compact; the rest stays in the menus.
+                if (action && action->icon().isNull())
+                    continue;
+
+                add_action(action);
+                if (action_count != before)
+                    group_used = true;
+            }
+
+            if (group_used)
+                add_separator();
+        }
+    }
+
+    add_separator();
+    add_action(ui->action_lock);
+    add_action(ui->action_exit);
+
+    quick_panel_->adjustSize();
+}
+
+//--------------------------------------------------------------------------------------------------
+QRect MainWindow::quickPanelHotZone() const
+{
+    QWidget* content = ui->tabs->currentWidget();
+    if (!content)
+        return QRect();
+
+    const QPoint top_left = content->mapToGlobal(QPoint(0, 0));
+    return QRect(top_left, QSize(content->width(), kQuickPanelHotZonePx));
+}
+
+//--------------------------------------------------------------------------------------------------
+void MainWindow::updateQuickPanelGeometry()
+{
+    QWidget* content = ui->tabs->currentWidget();
+    if (!content || !quick_panel_)
+        return;
+
+    quick_panel_->adjustSize();
+
+    const QPoint content_top_left = content->mapTo(this, QPoint(0, 0));
+    const int centered_x =
+        content_top_left.x() + (content->width() - quick_panel_->width()) / 2;
+
+    quick_panel_->move(qMax(content_top_left.x(), centered_x), content_top_left.y() + 2);
+}
+
+//--------------------------------------------------------------------------------------------------
+void MainWindow::showQuickPanel()
+{
+    if (!quick_panel_ || quick_panel_->isVisible())
+        return;
+
+    updateQuickPanelGeometry();
+    quick_panel_->show();
+    quick_panel_->raise();
+}
+
+//--------------------------------------------------------------------------------------------------
+bool MainWindow::eventFilter(QObject* object, QEvent* event)
+{
+    const QEvent::Type type = event->type();
+
+    if (quick_panel_ && (type == QEvent::MouseMove || type == QEvent::MouseButtonPress))
+    {
+        const QPoint global_pos = static_cast<QMouseEvent*>(event)->globalPosition().toPoint();
+
+        if (type == QEvent::MouseMove && quickPanelHotZone().contains(global_pos))
+        {
+            showQuickPanel();
+        }
+        else if (quick_panel_->isVisible())
+        {
+            const QRect panel_rect(quick_panel_->mapToGlobal(QPoint(0, 0)),
+                                   quick_panel_->size());
+
+            if (!panel_rect.contains(global_pos))
+                quick_panel_->hide();
+        }
+    }
+
+    return QMainWindow::eventFilter(object, event);
+}
