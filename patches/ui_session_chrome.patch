+//--------------------------------------------------------------------------------------------------
+void MainWindow::updateMainChrome()
+{
+    // Custom build: the menu bar and the toolbar are only needed on the host list (settings,
+    // credentials, quick connect, add/edit host). A remote session takes the whole window and is
+    // operated through its own floating toolbar instead.
+    const bool is_management = active_tab_ && active_tab_->tabType() == Tab::Type::MANAGEMENT;
+
+    ui->menubar->setVisible(is_management);
+    ui->toolbar->setVisible(is_management);
+}
