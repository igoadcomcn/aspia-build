+//--------------------------------------------------------------------------------------------------
+void MainWindow::updateMainChrome()
+{
+    // Custom build: the menu bar and the toolbar are only needed outside of a remote session
+    // (host list: settings, credentials, quick connect, add/edit host). A session takes the whole
+    // window and is operated through its own floating toolbar instead.
+    const bool is_session = active_tab_ && active_tab_->tabType() == Tab::Type::SESSION;
+
+    ui->menubar->setVisible(!is_session);
+    ui->toolbar->setVisible(!is_session);
+}
