+//--------------------------------------------------------------------------------------------------
+void MainWindow::updateMainChrome()
+{
+    // Custom build: no menu bar while a session is in front - the picture gets the whole window.
+    // A desktop session brings its own floating toolbar (revealed at the top edge), so the window
+    // toolbar goes away as well. Terminal / file transfer / system info have no toolbar of their
+    // own, so they keep the window toolbar - otherwise they would be left without any actions.
+    const bool is_session = active_tab_ && active_tab_->tabType() == Tab::Type::SESSION;
+
+    bool has_own_toolbar = false;
+    if (is_session)
+    {
+        if (ClientTab* client_tab = dynamic_cast<ClientTab*>(active_tab_))
+        {
+            ClientWindow* window = client_tab->clientWindow();
+            has_own_toolbar = window && window->sessionType() == proto::peer::SESSION_TYPE_DESKTOP;
+        }
+    }
+
+    ui->menubar->setVisible(false);
+    ui->toolbar->setVisible(!has_own_toolbar);
+}
+
+//--------------------------------------------------------------------------------------------------
+void MainWindow::createWindowCaption(QToolButton* add_button)
+{
+    // Custom build: the window is frameless. Its caption - the application name and the three
+    // window buttons - lives in the top-right corner of the tab strip, so the client looks like one
+    // continuous tab bar and a maximized window is all tabs and picture.
+    setWindowFlag(Qt::FramelessWindowHint, true);
+
+    caption_widget_ = new QWidget(ui->tabs);
+    caption_widget_->setObjectName(QStringLiteral("captionWidget"));
+
+    // Custom build: the caption is dragged with startSystemMove() instead of the native
+    // HTCAPTION hit test. The hit test made the whole caption row swallow its clicks as soon as
+    // the window was restored from the maximized state, which left the window buttons dead.
+    caption_widget_->installEventFilter(this);
+    ui->tabs->tabBar()->installEventFilter(this);
+
+    QBoxLayout* caption_layout = new QBoxLayout(QBoxLayout::LeftToRight, caption_widget_);
+    caption_layout->setContentsMargins(8, 2, 0, 2);
+    caption_layout->setSpacing(2);
+
+    caption_label_ = new QLabel(windowTitle(), caption_widget_);
+    caption_label_->setObjectName(QStringLiteral("captionLabel"));
+    caption_label_->setAttribute(Qt::WA_TransparentForMouseEvents, true);
+    {
+        QFont font = caption_label_->font();
+        font.setBold(true);
+        caption_label_->setFont(font);
+    }
+    caption_layout->addWidget(caption_label_);
+    caption_layout->addSpacing(6);
+
+    auto add_window_button = [this, caption_layout](const QString& text, const QString& tooltip)
+    {
+        QToolButton* button = new QToolButton(caption_widget_);
+        button->setText(text);
+        button->setToolTip(tooltip);
+        button->setAutoRaise(true);
+        button->setFocusPolicy(Qt::NoFocus);
+        button->setFixedSize(kWindowButtonWidthPx, kWindowButtonHeightPx);
+        caption_layout->addWidget(button);
+        return button;
+    };
+
+    QToolButton* minimize_button = add_window_button(uiString(u"\u2013"), tr("Minimize"));
+    connect(minimize_button, &QToolButton::clicked, this, [this]() { showMinimized(); });
+
+    maximize_button_ = add_window_button(uiString(u"\u25A1"), tr("Maximize"));
+    connect(maximize_button_, &QToolButton::clicked, this, &MainWindow::onMaximizeClicked);
+
+    QToolButton* close_button = add_window_button(uiString(u"\u2715"), tr("Close"));
+    close_button->setObjectName(QStringLiteral("closeWindowButton"));
+    connect(close_button, &QToolButton::clicked, this, &MainWindow::close);
+
+    QWidget* corner = new QWidget(ui->tabs);
+    corner->setObjectName(QStringLiteral("cornerWidget"));
+
+    QBoxLayout* corner_layout = new QBoxLayout(QBoxLayout::LeftToRight, corner);
+    corner_layout->setContentsMargins(0, 0, 2, 0);
+    corner_layout->setSpacing(2);
+    corner_layout->addWidget(add_button);
+    corner_layout->addSpacing(6);
+    corner_layout->addWidget(caption_widget_);
+
+    ui->tabs->setCornerWidget(corner, Qt::TopRightCorner);
+}
+
+//--------------------------------------------------------------------------------------------------
+void MainWindow::onMaximizeClicked()
+{
+    // The state is changed from a queued call: doing it inside the click handler of the button
+    // (while the click still holds the mouse) disrupts the mouse capture on Windows and the
+    // window buttons stop reacting.
+    QTimer::singleShot(0, this, [this]()
+    {
+        if (isMaximized())
+            showNormal();
+        else
+            showMaximized();
+    });
+}
+
+//--------------------------------------------------------------------------------------------------
+void MainWindow::startWindowDrag()
+{
+    // The window is frameless, so the caption drag is started explicitly. Returning HTCAPTION
+    // from the native hit test would make the caption swallow every click, including the ones
+    // that belong to the window buttons.
+    if (isFullScreen())
+        return;
+
+    if (QWindow* handle = windowHandle())
+        handle->startSystemMove();
+}
+
+//--------------------------------------------------------------------------------------------------
+bool MainWindow::eventFilter(QObject* object, QEvent* event)
+{
+    if (object != caption_widget_ && object != ui->tabs->tabBar())
+        return QMainWindow::eventFilter(object, event);
+
+    const QEvent::Type type = event->type();
+    if (type != QEvent::MouseButtonPress && type != QEvent::MouseButtonDblClick)
+        return QMainWindow::eventFilter(object, event);
+
+    QMouseEvent* mouse_event = static_cast<QMouseEvent*>(event);
+    if (mouse_event->button() != Qt::LeftButton)
+        return QMainWindow::eventFilter(object, event);
+
+    // Presses on a tab stay with the tab bar (selection, detaching, drag & drop).
+    if (object == ui->tabs->tabBar() &&
+        ui->tabs->tabBar()->tabAt(mouse_event->position().toPoint()) != -1)
+    {
+        return QMainWindow::eventFilter(object, event);
+    }
+
+    if (type == QEvent::MouseButtonDblClick)
+    {
+        onMaximizeClicked();
+        return true;
+    }
+
+    startWindowDrag();
+    return true;
+}
+//--------------------------------------------------------------------------------------------------
+bool MainWindow::nativeEvent(const QByteArray& event_type, void* message, qintptr* result)
+{
+#if defined(Q_OS_WIN)
+    if (event_type == QByteArrayLiteral("windows_generic_MSG") && message)
+    {
+        MSG* msg = static_cast<MSG*>(message);
+
+        // A frameless window would be maximized over the taskbar, so the limit is clamped to the
+        // work area of the current monitor.
+        if (msg->message == WM_GETMINMAXINFO)
+        {
+            HMONITOR monitor = MonitorFromWindow(reinterpret_cast<HWND>(winId()),
+                                                 MONITOR_DEFAULTTONEAREST);
+            MONITORINFO monitor_info = {};
+            monitor_info.cbSize = sizeof(monitor_info);
+
+            if (GetMonitorInfo(monitor, &monitor_info))
+            {
+                MINMAXINFO* min_max_info = reinterpret_cast<MINMAXINFO*>(msg->lParam);
+                min_max_info->ptMaxPosition.x = monitor_info.rcWork.left - monitor_info.rcMonitor.left;
+                min_max_info->ptMaxPosition.y = monitor_info.rcWork.top - monitor_info.rcMonitor.top;
+                min_max_info->ptMaxSize.x = monitor_info.rcWork.right - monitor_info.rcWork.left;
+                min_max_info->ptMaxSize.y = monitor_info.rcWork.bottom - monitor_info.rcWork.top;
+                return true;
+            }
+        }
+
+        if (msg->message == WM_NCHITTEST)
+        {
+            // A Win32 hit test message carries physical screen pixels, while mapFromGlobal()
+            // expects device-independent pixels. Without this division a display scaled to 200%
+            // made every point past the middle of a restored window look like the right resize
+            // border, so the window buttons and the toolbar stopped receiving clicks (a maximized
+            // window skipped the branch and kept working).
+            const qreal dpr = windowHandle() ? windowHandle()->devicePixelRatio() : 1.0;
+
+            const QPoint global_pos(GET_X_LPARAM(msg->lParam), GET_Y_LPARAM(msg->lParam));
+            const QPoint pos = mapFromGlobal((QPointF(global_pos) / dpr).toPoint());
+            const QRect client_rect = rect();
+
+            // The window buttons sit right at the top edge; the resize border must not steal
+            // their clicks.
+            const QWidget* corner = ui->tabs->cornerWidget(Qt::TopRightCorner);
+            const bool over_corner = corner && corner->isVisible() &&
+                corner->rect().contains(corner->mapFrom(this, pos));
+
+            // A frameless window has no native border, so the resize edges are hit-tested here.
+            if (!isMaximized() && !isFullScreen() && !over_corner)
+            {
+                const bool on_left = pos.x() < kResizeBorderPx;
+                const bool on_right = pos.x() >= client_rect.width() - kResizeBorderPx;
+                const bool on_top = pos.y() < kResizeBorderPx;
+                const bool on_bottom = pos.y() >= client_rect.height() - kResizeBorderPx;
+
+                if (on_left || on_right || on_top || on_bottom)
+                {
+                    if (on_top && on_left)
+                        *result = HTTOPLEFT;
+                    else if (on_top && on_right)
+                        *result = HTTOPRIGHT;
+                    else if (on_bottom && on_left)
+                        *result = HTBOTTOMLEFT;
+                    else if (on_bottom && on_right)
+                        *result = HTBOTTOMRIGHT;
+                    else if (on_left)
+                        *result = HTLEFT;
+                    else if (on_right)
+                        *result = HTRIGHT;
+                    else if (on_top)
+                        *result = HTTOP;
+                    else
+                        *result = HTBOTTOM;
+                    return true;
+                }
+            }
+
+        }
+    }
+#endif
+    return QMainWindow::nativeEvent(event_type, message, result);
+}
+
+//--------------------------------------------------------------------------------------------------
+void MainWindow::changeEvent(QEvent* event)
+{
+    if (event->type() == QEvent::WindowTitleChange && caption_label_)
+        caption_label_->setText(windowTitle());
+
+    if (event->type() == QEvent::WindowStateChange && maximize_button_)
+    {
+        maximize_button_->setText(isMaximized() ? uiString(u"\u2750") : uiString(u"\u25A1"));
+        maximize_button_->setToolTip(isMaximized() ? tr("Restore") : tr("Maximize"));
+    }
+
+    QMainWindow::changeEvent(event);
+}
+
+//--------------------------------------------------------------------------------------------------
+void MainWindow::onGlobalContextMenu(const QPoint& global_pos)
+{
+    // Custom build: the menu bar is gone, so the host list exposes the same commands through a
+    // context menu. The actions themselves are shared with the (hidden) menus, so their state,
+    // shortcuts and signals keep working.
+    QMenu menu(this);
+
+    for (QAction* top_action : ui->menubar->actions())
+    {
+        QMenu* source = top_action->menu();
+        if (!source || !top_action->isVisible())
+            continue;
+
+        QList<QAction*> entries;
+        for (QAction* action : source->actions())
+        {
+            if (action->isSeparator() || !action->isVisible())
+                continue;
+            entries.append(action);
+        }
+
+        if (entries.isEmpty())
+            continue;
+
+        if (!menu.isEmpty())
+            menu.addSeparator();
+
+        menu.addSection(top_action->text());
+
+        for (QAction* action : entries)
+        {
+            if (QMenu* submenu = action->menu())
+            {
+                QMenu* copy = menu.addMenu(action->text());
+                for (QAction* item : submenu->actions())
+                {
+                    if (item->isSeparator() || !item->isVisible())
+                        continue;
+                    copy->addAction(item);
+                }
+            }
+            else
+            {
+                menu.addAction(action);
+            }
+        }
+    }
+
+    if (!menu.isEmpty())
+        menu.exec(global_pos);
+}
