+//--------------------------------------------------------------------------------------------------
+bool MainWindow::isCaptionPosition(const QPoint& pos) const
+{
+    QWidget* widget = childAt(pos);
+    if (!widget)
+        return false;
+
+    // The window buttons and the "+" button must stay clickable, so they never count as caption.
+    if (qobject_cast<QAbstractButton*>(widget))
+        return false;
+
+    if (caption_widget_ && (widget == caption_widget_ || caption_widget_->isAncestorOf(widget)))
+        return true;
+
+    // The empty part of the tab strip can be used to drag the window as well.
+    QTabBar* tab_bar = ui->tabs->tabBar();
+    const QPoint bar_pos = tab_bar->mapFrom(this, pos);
+    return tab_bar->rect().contains(bar_pos) && tab_bar->tabAt(bar_pos) == -1;
+}
