+//--------------------------------------------------------------------------------------------------
+void DesktopToolBar::revealPanel()
+{
+    // Custom build: the panel is opened by the desktop window as well (mouse on the top edge of the
+    // picture), so it must be re-openable an unlimited number of times. Every early return here made
+    // the panel appear exactly once, which is why the state is checked against the panel itself and
+    // not against temporary hover flags.
+    if (!ui->toolbar->isHidden())
+        return;
+
+    leaved_ = false;
+
+    if (hide_timer_->isActive())
+        hide_timer_->stop();
+
+    ui->toolbar->show();
+    ui->frame->hide();
+
+    emit sig_showHidePanel();
+}
