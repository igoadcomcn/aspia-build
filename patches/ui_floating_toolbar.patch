+//--------------------------------------------------------------------------------------------------
+void DesktopWindow::maybeRevealPanel()
+{
+    // Custom build: the session toolbar is reachable by touching the top edge of the picture.
+    // The cursor position is checked instead of a hover event of some helper widget, so the
+    // panel can be opened again and again instead of only once.
+    bool in_zone = false;
+
+    if (isVisible())
+    {
+        QWidget* viewport = scroll_area_->viewport();
+
+        if (viewport->isVisible())
+        {
+            const QPoint pos = viewport->mapFromGlobal(QCursor::pos());
+            in_zone = pos.x() >= 0 && pos.x() < viewport->width() &&
+                pos.y() >= 0 && pos.y() < kRevealZoneHeight;
+        }
+    }
+
+    // Only the moment the cursor enters the zone opens the panel. Without the transition check a
+    // panel that closes while the cursor stays in the zone would immediately open again.
+    if (in_zone && !reveal_zone_active_ && toolbar_->isPanelHidden())
+        toolbar_->revealPanel();
+
+    reveal_zone_active_ = in_zone;
+}
