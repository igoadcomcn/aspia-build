--- a/source/client/desktop/main_window.cc
+++ b/source/client/desktop/main_window.cc
@@ -584,6 +584,28 @@ void MainWindow::onCloseTab(int index)
 
     ui->tabs->removeTab(index);
     delete tab;
+
+    // Custom build: when the last session is gone, bring the address book back.
+    bool has_session = false;
+    for (int i = 0; i < ui->tabs->count(); ++i)
+    {
+        Tab* remaining = tabAt(i);
+        if (remaining && remaining->tabType() == Tab::Type::SESSION)
+        {
+            has_session = true;
+            break;
+        }
+    }
+
+    if (!has_session)
+    {
+        if (ManagementTab* management_tab = managementTab())
+        {
+            int management_index = ui->tabs->indexOf(management_tab);
+            ui->tabs->tabBar()->setTabVisible(management_index, true);
+            ui->tabs->setCurrentIndex(management_index);
+        }
+    }
 }
 
