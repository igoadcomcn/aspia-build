+// along with this program. If not, see <https://www.gnu.org/licenses/>.
+//
+
+#ifndef CLIENT_DEFAULT_CREDENTIALS_H
+#define CLIENT_DEFAULT_CREDENTIALS_H
+
+#include <optional>
+
+#include <QString>
+
+#include "base/crypto/secure_string.h"
+
+// Global default credentials for a portable ("green") client build.
+// They are kept in "aspia_default_login.ini" next to aspia_client.exe, so the whole
+// folder can be moved to another machine without an installer.
+struct DefaultCredentials
+{
+    QString username;
+    SecureString password;
+};
+
+// Reads the default credentials. Returns std::nullopt when nothing is stored, when the
+// file has been disabled or when the password can not be decrypted (for example after
+// copying the folder to another Windows account).
+std::optional<DefaultCredentials> loadDefaultCredentials();
+
+// Writes (or replaces) the default credentials. The password is encrypted with the OS
+// keystore (DPAPI on Windows) before it goes to disk.
+bool saveDefaultCredentials(const QString& username, const SecureString& password);
+
+// Removes the stored user name and password but keeps the "enabled" switch untouched.
+void clearDefaultCredentials();
+
+#endif // CLIENT_DEFAULT_CREDENTIALS_H
