+    // Custom build: a fixed "+" button at the far right of the toolbar. Unlike the actions
+    // injected by installTabActions(), a plain widget survives removeTabActions(), so it stays
+    // next to the window buttons no matter which tab is active.
+    QToolButton* add_button = new QToolButton(this);
+    add_button->setText(QStringLiteral("+"));
+    add_button->setToolTip(tr("Connect to a saved host"));
+    add_button->setAutoRaise(true);
+    add_button->setPopupMode(QToolButton::InstantPopup);
+    add_button->setToolButtonStyle(Qt::ToolButtonTextOnly);
+
+    QMenu* hosts_menu = new QMenu(add_button);
+    add_button->setMenu(hosts_menu);
+    ui->toolbar->addWidget(add_button);
+
+    connect(hosts_menu, &QMenu::aboutToShow, this, [this, hosts_menu]()
+    {
+        hosts_menu->clear();
+
+        QList<LocalHostConfig> hosts;
+        if (Database::instance().allLocalHosts(&hosts) == Database::ReadResult::FAILED)
+        {
+            hosts_menu->addAction(tr("Unable to read the host list"))->setEnabled(false);
+            return;
+        }
+
+        if (hosts.isEmpty())
+        {
+            hosts_menu->addAction(tr("No saved hosts"))->setEnabled(false);
+        }
+        else
+        {
+            for (const LocalHostConfig& saved_host : hosts)
+            {
+                const QString label = saved_host.name().isEmpty()
+                    ? saved_host.address()
+                    : QStringLiteral("%1  (%2)").arg(saved_host.name(), saved_host.address());
+
+                QAction* action = hosts_menu->addAction(label);
+                const HostConfig host = HostConfig::forLocalHost(saved_host);
+
+                connect(action, &QAction::triggered, this, [this, host]()
+                {
+                    onConnect(host, proto::peer::SESSION_TYPE_DESKTOP);
+                });
+            }
+        }
+
+        hosts_menu->addSeparator();
+        hosts_menu->addAction(tr("Manage hosts..."), this, [this]()
+        {
+            if (ManagementTab* management_tab = managementTab())
+            {
+                const int index = ui->tabs->indexOf(management_tab);
+                if (index != -1)
+                {
+                    ui->tabs->tabBar()->setTabVisible(index, true);
+                    ui->tabs->setCurrentIndex(index);
+                }
+            }
+        });
+    });
+
     bool search_field_enabled = settings.isSearchFieldEnabled();
     ui->action_search_field->setChecked(search_field_enabled);
     search_action_->setVisible(search_field_enabled);
