 namespace {
 
+// Fixed password that provides the key for the storage cryptor in this custom build. It is not
+// a secret: this build intentionally has no master password dialog and stores its data without
+// user-visible protection.
+constexpr char kBuiltInPassword[] = "aspia-custom-335";
+
+//--------------------------------------------------------------------------------------------------
+// The original build refuses to start until a master password is set, so in the original a
+// "cryptor without a key" state never exists. This build has no dialog, so the key is provided
+// by a fixed built-in password instead. A database encrypted with a user-chosen master password
+// cannot be decrypted without it, so such a database is reset the same way the "Forgot password?"
+// link of the original build does: a backup copy is saved first, then the database is cleared.
+bool ensureCryptorKey()
+{
+    const SecureString builtin_password = SecureString::fromUtf8(
+        SecureByteArray(kBuiltInPassword, static_cast<qsizetype>(std::strlen(kBuiltInPassword))));
+
+    if (!MasterPassword::isSet())
+    {
+        if (MasterPassword::setNew(builtin_password) != MasterPassword::Result::SUCCESS)
+        {
+            LOG(ERROR) << "Unable to initialize the storage key";
+            MsgBox::warning(nullptr, "Unable to initialize the storage key.");
+            return false;
+        }
+        return true;
+    }
+
+    if (MasterPassword::unlock(builtin_password) == MasterPassword::Result::SUCCESS)
+        return true;
+
+    const QFileInfo file_info(Database::filePath());
+    const QString copy_path = QString("%1/%2-%3.%4").arg(file_info.path(), file_info.completeBaseName(),
+        QDateTime::currentDateTime().toString("yyyyMMdd-hhmmss"), file_info.suffix());
+
+    if (!Database::instance().saveCopyAndClearAll(copy_path))
+    {
+        LOG(ERROR) << "Unable to reset the database";
+        MsgBox::warning(nullptr, "Unable to reset the database.");
+        return false;
+    }
+
+    if (MasterPassword::setNew(builtin_password) != MasterPassword::Result::SUCCESS)
+    {
+        LOG(ERROR) << "Unable to initialize the storage key after the database reset";
+        MsgBox::warning(nullptr, "Unable to initialize the storage key.");
+        return false;
+    }
+
+    LOG(INFO) << "The database was encrypted with an unknown master password and has been reset";
+    MsgBox::information(nullptr, QString(
+        "The database was protected by a master password which this build does not use. "
+        "The database has been reset, a backup copy is saved to the file \"%1\".")
+            .arg(QDir::toNativeSeparators(copy_path)));
+    return true;
+}
+
